# ========== Web (apps/web) ==========
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Optional: enterprise SSO (SAML/OIDC). Leave blank for email-only.
AUTH_AZURE_AD_ID=
AUTH_AZURE_AD_SECRET=
AUTH_AZURE_AD_TENANT_ID=
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=

# ========== API (apps/api) ==========
# Local default is SQLite — no install required. For production use Postgres:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiready
DATABASE_URL=sqlite:///./aiready.db
# Redis is only needed if you want a real Celery worker; FastAPI BackgroundTasks
# handles scans inline as a fallback.
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-strong-secret
CORS_ORIGINS=http://localhost:3000

# AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Connectors (leave blank to use the mock connector)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
